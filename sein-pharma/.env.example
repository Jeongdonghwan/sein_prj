# 복사해서 .env 로 저장 후 값 채우기:  cp .env.example .env
# SECRET_KEY 생성:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-random-hex

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sein
DB_PASSWORD=your-db-password
DB_NAME=sein_pharma

# HTTPS 적용 후 1 로 변경 (세션 쿠키 Secure 플래그)
SESSION_COOKIE_SECURE=0

# 텔레그램 문의 알림 (비워두면 알림 발송을 건너뜀)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
